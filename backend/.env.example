# Server
PORT=5000
NODE_ENV=development

# Frontend URL(s) allowed to call this API.
# For multiple origins, separate them with commas.
ALLOWED_ORIGINS=http://localhost:5173,https://your-domain.com

# Resend API
# Keep this secret. Never expose it in the frontend.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx

# Inbox that receives contact-form messages
MAIL_TO=your-email@example.com

# Sender must be a Resend-verified domain/address in production.
# Example: Portfolio <hello@yourdomain.com>
MAIL_FROM=Portfolio <hello@yourdomain.com>

# Optional: used in the email subject
SITE_NAME=Your Portfolio
